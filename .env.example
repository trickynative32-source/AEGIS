# ==========================================
# AEGIS — Assisted Executive Guidance and Intelligence System
# Environment Configuration
# ==========================================

# AI Model Settings (Gemini 2.0 Flash / OpenRouter)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
VISION_MODEL=google/gemini-2.0-flash-001

# NVIDIA LocateAnything-3B Grounding Model Settings
NVIDIA_LOCATE_ANYTHING_ENABLED=true
NVIDIA_LOCATE_ANYTHING_URL=http://localhost:30000/v1
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=nvidia/LocateAnything-3B

# Database Configuration
DATABASE_URL=sqlite:///./aegis.db

# TTS (Text-to-Speech)
TTS_PROVIDER=edge-tts
TTS_VOICE=en-US-ChristopherNeural
TTS_SPEED=+0%
TTS_PITCH=+0Hz

# STT (Speech-to-Text)
STT_PROVIDER=faster-whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Privacy and Permissions
CAMERA_ENABLED=false
CONTINUOUS_CAMERA=false
LOCATION_ENABLED=true
AUTOMATION_ENABLED=true
LEARNING_ENABLED=true
CLOUD_VISION_ENABLED=true
WAKE_WORD_ENABLED=false
VOICE_FIRST_MODE=false

# Server Settings
HOST=127.0.0.1
PORT=8000
